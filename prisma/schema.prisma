generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id              String      @id @default(uuid())
  username        String      @unique
  displayName     String
  passwordHash    String
  role            String      @db.VarChar(32)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  visits          Visit[]     @relation("ResponsibleDoctor")
  cashierShifts   CashShift[] @relation("CashierShifts")
  createdPayments Payment[]   @relation("CreatedPayments")
}

model Patient {
  id          String   @id @default(uuid())
  patientCode String   @unique
  fullName    String
  dateOfBirth DateTime
  gender      String
  phone       String   @unique
  nationalId  String?  @unique
  allergies   String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  visits      Visit[]
}

model Visit {
  id           String             @id @default(uuid())
  visitCode    String             @unique
  patientId    String
  doctorId     String
  type         String             @db.VarChar(32)
  status       String             @default("NEW") @db.VarChar(32)
  grossCharge  Decimal            @default(0) @db.Decimal(18, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctor       User               @relation("ResponsibleDoctor", fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  emr          EmrRecord?
  payments     Payment[]
  reservations StockReservation[]

  @@index([patientId, createdAt])
  @@index([status, createdAt])
}

model EmrRecord {
  id             String          @id @default(uuid())
  visitId        String          @unique
  clinicalNote   String?
  lockedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  visit          Visit           @relation(fields: [visitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  treatmentLines TreatmentLine[]
  consents       Consent[]
  settlement     Settlement?
}

model TreatmentLine {
  id              String    @id @default(uuid())
  emrId           String
  serviceCode     String
  serviceName     String
  unitPrice       Decimal   @db.Decimal(18, 2)
  quantity        Int       @default(1)
  requiresConsent Boolean   @default(false)
  createdAt       DateTime  @default(now())
  emr             EmrRecord @relation(fields: [emrId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([emrId])
}

model Consent {
  id                String    @id @default(uuid())
  consentCode       String    @unique
  emrId             String
  serviceCode       String
  status            String    @default("PENDING_SIGNATURE") @db.VarChar(32)
  signedAt          DateTime?
  revokedAt         DateTime?
  signedDocumentUrl String?
  createdAt         DateTime  @default(now())
  emr               EmrRecord @relation(fields: [emrId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([emrId, status])
}

model Settlement {
  id             String    @id @default(uuid())
  settlementCode String    @unique
  emrId          String    @unique
  idempotencyKey String    @unique
  grossCharge    Decimal   @db.Decimal(18, 2)
  createdAt      DateTime  @default(now())
  emr            EmrRecord @relation(fields: [emrId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CashShift {
  id            String    @id @default(uuid())
  shiftCode     String    @unique
  cashierId     String
  status        String    @default("OPEN") @db.VarChar(32)
  openingFloat  Decimal   @db.Decimal(18, 2)
  cashCollected Decimal   @default(0) @db.Decimal(18, 2)
  cashPaidOut   Decimal   @default(0) @db.Decimal(18, 2)
  countedCash   Decimal?
  difference    Decimal?
  closeNote     String?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  cashier       User      @relation("CashierShifts", fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments      Payment[]
}

model Payment {
  id              String     @id @default(uuid())
  transactionCode String     @unique
  idempotencyKey  String     @unique
  visitId         String
  cashShiftId     String?
  createdById     String
  method          String     @db.VarChar(32)
  amount          Decimal    @db.Decimal(18, 2)
  createdAt       DateTime   @default(now())
  visit           Visit      @relation(fields: [visitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashShift       CashShift? @relation(fields: [cashShiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User       @relation("CreatedPayments", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([visitId, createdAt])
  @@index([cashShiftId, createdAt])
}

model InventoryItem {
  id          String     @id @default(uuid())
  itemCode    String     @unique
  name        String
  unit        String     @db.VarChar(32)
  requiresLot Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lots        StockLot[]
}

model StockLot {
  id               String             @id @default(uuid())
  lotCode          String
  itemId           String
  quantityOnHand   Decimal            @db.Decimal(18, 3)
  quantityReserved Decimal            @default(0) @db.Decimal(18, 3)
  unitCost         Decimal            @db.Decimal(18, 2)
  expiryDate       DateTime?
  status           String             @default("AVAILABLE") @db.VarChar(32)
  createdAt        DateTime           @default(now())
  item             InventoryItem      @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservations     StockReservation[]

  @@unique([itemId, lotCode])
  @@index([itemId, expiryDate, createdAt])
}

model StockReservation {
  id              String    @id @default(uuid())
  reservationCode String    @unique
  visitId         String
  itemId          String
  lotId           String
  quantity        Decimal   @db.Decimal(18, 3)
  status          String    @default("RESERVED") @db.VarChar(32)
  createdAt       DateTime  @default(now())
  consumedAt      DateTime?
  releasedAt      DateTime?
  visit           Visit     @relation(fields: [visitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lot             StockLot  @relation(fields: [lotId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([visitId, status])
  @@index([itemId, status])
}

model ServiceCatalog {
  id              String   @id @default(uuid())
  serviceCode     String   @unique
  serviceName     String
  category        String   @db.VarChar(64)
  defaultPrice    Decimal  @db.Decimal(18, 2)
  requiresConsent Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PriceListLine {
  id            String    @id @default(uuid())
  priceCode     String    @unique
  serviceCode   String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  unitPrice     Decimal   @db.Decimal(18, 2)
  taxRate       Decimal   @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())

  @@index([serviceCode, effectiveFrom])
}

model Deposit {
  id            String   @id @default(uuid())
  depositCode   String   @unique
  patientId     String
  visitId       String?
  amount        Decimal  @db.Decimal(18, 2)
  appliedAmount Decimal  @default(0) @db.Decimal(18, 2)
  status        String   @default("AVAILABLE") @db.VarChar(32)
  createdAt     DateTime @default(now())
}

model SterilizationCycle {
  id              String    @id @default(uuid())
  cycleCode       String    @unique
  machineName     String
  temperatureC    Decimal   @db.Decimal(6, 2)
  pressureBar     Decimal   @db.Decimal(6, 2)
  durationMinutes Int
  resultStatus    String    @default("IN_PROGRESS") @db.VarChar(32)
  operatorId      String
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model InstrumentPack {
  id                   String   @id @default(uuid())
  packCode             String   @unique
  packName             String
  sterilizationCycleId String
  sterilizedAt         DateTime
  expiryAt             DateTime
  status               String   @default("STERILE") @db.VarChar(32)
  createdAt            DateTime @default(now())
}

model DentalLabTicket {
  id              String    @id @default(uuid())
  ticketCode      String    @unique
  visitId         String
  patientId       String
  labName         String
  restorationType String
  status          String    @default("SENT") @db.VarChar(32)
  sentAt          DateTime
  dueAt           DateTime?
  receivedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model LabReworkCycle {
  id             String   @id @default(uuid())
  reworkCode     String   @unique
  labTicketId    String
  reason         String
  responsibility String   @db.VarChar(32)
  charge         Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("OPEN") @db.VarChar(32)
  createdAt      DateTime @default(now())
}

model InsuranceClaim {
  id             String    @id @default(uuid())
  claimCode      String    @unique
  visitId        String
  patientId      String
  payerName      String
  status         String    @default("DRAFT") @db.VarChar(32)
  submittedAt    DateTime?
  approvedAmount Decimal   @default(0) @db.Decimal(18, 2)
  patientAmount  Decimal   @default(0) @db.Decimal(18, 2)
  createdAt      DateTime  @default(now())
}

model AccountingVoucher {
  id           String    @id @default(uuid())
  voucherCode  String    @unique
  voucherType  String    @db.VarChar(32)
  sourceType   String    @db.VarChar(64)
  sourceId     String
  amount       Decimal   @db.Decimal(18, 2)
  status       String    @default("DRAFT") @db.VarChar(32)
  createdById  String
  approvedById String?
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
}

model JournalEntry {
  id          String        @id @default(uuid())
  entryCode   String        @unique
  sourceType  String        @db.VarChar(64)
  sourceId    String
  status      String        @default("DRAFT") @db.VarChar(32)
  totalDebit  Decimal       @default(0) @db.Decimal(18, 2)
  totalCredit Decimal       @default(0) @db.Decimal(18, 2)
  createdById String
  createdAt   DateTime      @default(now())
  lines       JournalLine[]
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountCode    String       @db.VarChar(32)
  description    String?
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Warranty {
  id           String   @id @default(uuid())
  warrantyCode String   @unique
  patientId    String
  visitId      String
  serviceCode  String
  status       String   @default("ACTIVE") @db.VarChar(32)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())
}

model DiscountApproval {
  id            String    @id @default(uuid())
  approvalCode  String    @unique
  visitId       String
  requestedById String
  approvedById  String?
  percentage    Decimal   @db.Decimal(5, 2)
  amount        Decimal   @db.Decimal(18, 2)
  status        String    @default("PENDING") @db.VarChar(32)
  reason        String
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?
}

model Addendum {
  id           String   @id @default(uuid())
  addendumCode String   @unique
  emrId        String
  reason       String
  content      String
  createdById  String
  createdAt    DateTime @default(now())
}

model CommissionAdjustment {
  id             String   @id @default(uuid())
  adjustmentCode String   @unique
  visitId        String
  doctorId       String
  amount         Decimal  @db.Decimal(18, 2)
  reason         String
  createdAt      DateTime @default(now())
}

model Prescription {
  id               String   @id @default(uuid())
  prescriptionCode String   @unique
  visitId          String
  patientId        String
  status           String   @default("ISSUED") @db.VarChar(32)
  issuedAt         DateTime @default(now())
}

model LabOrder {
  id          String    @id @default(uuid())
  orderCode   String    @unique
  visitId     String
  patientId   String
  testName    String
  status      String    @default("ORDERED") @db.VarChar(32)
  orderedAt   DateTime  @default(now())
  completedAt DateTime?
}

model AuditLog {
  id         String   @id @default(uuid())
  logCode    String   @unique
  actorId    String
  action     String   @db.VarChar(64)
  entityName String   @db.VarChar(64)
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([entityName, entityId, createdAt])
}

model DeletedRecord {
  id           String   @id @default(uuid())
  deletedCode  String   @unique
  entityName   String   @db.VarChar(64)
  originalId   String
  snapshotJson String
  deletedById  String
  reason       String
  deletedAt    DateTime @default(now())

  @@index([entityName, originalId])
  @@index([deletedById, deletedAt])
}

model PatientDeleted {
  id                String   @id @default(uuid())
  archiveCode       String   @unique
  originalPatientId String
  patientCode       String
  fullName          String
  dateOfBirth       DateTime
  gender            String
  phone             String
  nationalId        String?
  allergies         String?
  deletedById       String
  reason            String
  deletedAt         DateTime @default(now())
}

model VisitDeleted {
  id                String   @id @default(uuid())
  archiveCode       String   @unique
  originalVisitId   String
  visitCode         String
  patientId         String
  doctorId          String
  visitType         String
  visitStatus       String
  grossCharge       Decimal  @db.Decimal(18, 2)
  originalCreatedAt DateTime
  deletedById       String
  reason            String
  deletedAt         DateTime @default(now())
}

model EmrRecordDeleted {
  id               String    @id @default(uuid())
  archiveCode      String    @unique
  originalEmrId    String
  visitId          String
  clinicalNote     String?
  originalLockedAt DateTime?
  deletedById      String
  reason           String
  deletedAt        DateTime  @default(now())
}

model PaymentDeleted {
  id                String   @id @default(uuid())
  archiveCode       String   @unique
  originalPaymentId String
  transactionCode   String
  visitId           String
  cashShiftId       String?
  createdById       String
  paymentMethod     String
  amount            Decimal  @db.Decimal(18, 2)
  originalCreatedAt DateTime
  deletedById       String
  reason            String
  deletedAt         DateTime @default(now())
}

model StockLotDeleted {
  id                 String    @id @default(uuid())
  archiveCode        String    @unique
  originalStockLotId String
  lotCode            String
  itemId             String
  quantityOnHand     Decimal   @db.Decimal(18, 3)
  quantityReserved   Decimal   @db.Decimal(18, 3)
  unitCost           Decimal   @db.Decimal(18, 2)
  expiryDate         DateTime?
  originalStatus     String    @db.VarChar(32)
  deletedById        String
  reason             String
  deletedAt          DateTime  @default(now())
}

model UserDeleted {
  id                String   @id @default(uuid())
  archiveCode       String   @unique
  originalUserId    String
  username          String
  displayName       String
  role              String   @db.VarChar(32)
  originalCreatedAt DateTime
  deletedById       String
  reason            String
  deletedAt         DateTime @default(now())

  @@index([originalUserId])
  @@index([deletedById, deletedAt])
}

model TreatmentLineDeleted {
  id                      String   @id @default(uuid())
  archiveCode             String   @unique
  originalTreatmentLineId String
  emrId                   String
  serviceCode             String
  serviceName             String
  unitPrice               Decimal  @db.Decimal(18, 2)
  quantity                Int
  requiresConsent         Boolean
  originalCreatedAt       DateTime
  deletedById             String
  reason                  String
  deletedAt               DateTime @default(now())

  @@index([originalTreatmentLineId])
  @@index([emrId])
  @@index([deletedById, deletedAt])
}

model ConsentDeleted {
  id                String    @id @default(uuid())
  archiveCode       String    @unique
  originalConsentId String
  consentCode       String
  emrId             String
  serviceCode       String
  status            String    @db.VarChar(32)
  signedAt          DateTime?
  revokedAt         DateTime?
  signedDocumentUrl String?
  originalCreatedAt DateTime
  deletedById       String
  reason            String
  deletedAt         DateTime  @default(now())

  @@index([originalConsentId])
  @@index([emrId])
  @@index([deletedById, deletedAt])
}

model SettlementDeleted {
  id                   String   @id @default(uuid())
  archiveCode          String   @unique
  originalSettlementId String
  settlementCode       String
  emrId                String
  idempotencyKey       String
  grossCharge          Decimal  @db.Decimal(18, 2)
  originalCreatedAt    DateTime
  deletedById          String
  reason               String
  deletedAt            DateTime @default(now())

  @@index([originalSettlementId])
  @@index([emrId])
  @@index([deletedById, deletedAt])
}

model CashShiftDeleted {
  id                  String    @id @default(uuid())
  archiveCode         String    @unique
  originalCashShiftId String
  shiftCode           String
  cashierId           String
  status              String    @db.VarChar(32)
  openingFloat        Decimal   @db.Decimal(18, 2)
  cashCollected       Decimal   @db.Decimal(18, 2)
  cashPaidOut         Decimal   @db.Decimal(18, 2)
  countedCash         Decimal?
  difference          Decimal?
  closeNote           String?
  openedAt            DateTime
  closedAt            DateTime?
  deletedById         String
  reason              String
  deletedAt           DateTime  @default(now())

  @@index([originalCashShiftId])
  @@index([cashierId])
  @@index([deletedById, deletedAt])
}

model InventoryItemDeleted {
  id                      String   @id @default(uuid())
  archiveCode             String   @unique
  originalInventoryItemId String
  itemCode                String
  name                    String
  unit                    String   @db.VarChar(32)
  requiresLot             Boolean
  originalCreatedAt       DateTime
  deletedById             String
  reason                  String
  deletedAt               DateTime @default(now())

  @@index([originalInventoryItemId])
  @@index([deletedById, deletedAt])
}

model StockReservationDeleted {
  id                         String    @id @default(uuid())
  archiveCode                String    @unique
  originalStockReservationId String
  reservationCode            String
  visitId                    String
  itemId                     String
  lotId                      String
  quantity                   Decimal   @db.Decimal(18, 3)
  status                     String    @db.VarChar(32)
  originalCreatedAt          DateTime
  consumedAt                 DateTime?
  releasedAt                 DateTime?
  deletedById                String
  reason                     String
  deletedAt                  DateTime  @default(now())

  @@index([originalStockReservationId])
  @@index([visitId])
  @@index([itemId])
  @@index([lotId])
  @@index([deletedById, deletedAt])
}

model ServiceCatalogDeleted {
  id                       String   @id @default(uuid())
  archiveCode              String   @unique
  originalServiceCatalogId String
  serviceCode              String
  serviceName              String
  category                 String   @db.VarChar(64)
  defaultPrice             Decimal  @db.Decimal(18, 2)
  requiresConsent          Boolean
  isActive                 Boolean
  originalCreatedAt        DateTime
  deletedById              String
  reason                   String
  deletedAt                DateTime @default(now())

  @@index([originalServiceCatalogId])
  @@index([deletedById, deletedAt])
}

model PriceListLineDeleted {
  id                      String    @id @default(uuid())
  archiveCode             String    @unique
  originalPriceListLineId String
  priceCode               String
  serviceCode             String
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  unitPrice               Decimal   @db.Decimal(18, 2)
  taxRate                 Decimal   @db.Decimal(5, 2)
  originalCreatedAt       DateTime
  deletedById             String
  reason                  String
  deletedAt               DateTime  @default(now())

  @@index([originalPriceListLineId])
  @@index([serviceCode])
  @@index([deletedById, deletedAt])
}

model DepositDeleted {
  id                String   @id @default(uuid())
  archiveCode       String   @unique
  originalDepositId String
  depositCode       String
  patientId         String
  visitId           String?
  amount            Decimal  @db.Decimal(18, 2)
  appliedAmount     Decimal  @db.Decimal(18, 2)
  status            String   @db.VarChar(32)
  originalCreatedAt DateTime
  deletedById       String
  reason            String
  deletedAt         DateTime @default(now())

  @@index([originalDepositId])
  @@index([patientId])
  @@index([visitId])
  @@index([deletedById, deletedAt])
}

model SterilizationCycleDeleted {
  id                           String    @id @default(uuid())
  archiveCode                  String    @unique
  originalSterilizationCycleId String
  cycleCode                    String
  machineName                  String
  temperatureC                 Decimal   @db.Decimal(6, 2)
  pressureBar                  Decimal   @db.Decimal(6, 2)
  durationMinutes              Int
  resultStatus                 String    @db.VarChar(32)
  operatorId                   String
  startedAt                    DateTime
  completedAt                  DateTime?
  originalCreatedAt            DateTime
  deletedById                  String
  reason                       String
  deletedAt                    DateTime  @default(now())

  @@index([originalSterilizationCycleId])
  @@index([operatorId])
  @@index([deletedById, deletedAt])
}

model InstrumentPackDeleted {
  id                       String   @id @default(uuid())
  archiveCode              String   @unique
  originalInstrumentPackId String
  packCode                 String
  packName                 String
  sterilizationCycleId     String
  sterilizedAt             DateTime
  expiryAt                 DateTime
  status                   String   @db.VarChar(32)
  originalCreatedAt        DateTime
  deletedById              String
  reason                   String
  deletedAt                DateTime @default(now())

  @@index([originalInstrumentPackId])
  @@index([sterilizationCycleId])
  @@index([deletedById, deletedAt])
}

model DentalLabTicketDeleted {
  id                        String    @id @default(uuid())
  archiveCode               String    @unique
  originalDentalLabTicketId String
  ticketCode                String
  visitId                   String
  patientId                 String
  labName                   String
  restorationType           String
  status                    String    @db.VarChar(32)
  sentAt                    DateTime
  dueAt                     DateTime?
  receivedAt                DateTime?
  originalCreatedAt         DateTime
  deletedById               String
  reason                    String
  deletedAt                 DateTime  @default(now())

  @@index([originalDentalLabTicketId])
  @@index([visitId])
  @@index([patientId])
  @@index([deletedById, deletedAt])
}

model LabReworkCycleDeleted {
  id                       String   @id @default(uuid())
  archiveCode              String   @unique
  originalLabReworkCycleId String
  reworkCode               String
  labTicketId              String
  reason                   String
  responsibility           String   @db.VarChar(32)
  charge                   Decimal  @db.Decimal(18, 2)
  status                   String   @db.VarChar(32)
  originalCreatedAt        DateTime
  deletedById              String
  deleteReason             String
  deletedAt                DateTime @default(now())

  @@index([originalLabReworkCycleId])
  @@index([labTicketId])
  @@index([deletedById, deletedAt])
}

model InsuranceClaimDeleted {
  id                       String    @id @default(uuid())
  archiveCode              String    @unique
  originalInsuranceClaimId String
  claimCode                String
  visitId                  String
  patientId                String
  payerName                String
  status                   String    @db.VarChar(32)
  submittedAt              DateTime?
  approvedAmount           Decimal   @db.Decimal(18, 2)
  patientAmount            Decimal   @db.Decimal(18, 2)
  originalCreatedAt        DateTime
  deletedById              String
  reason                   String
  deletedAt                DateTime  @default(now())

  @@index([originalInsuranceClaimId])
  @@index([visitId])
  @@index([patientId])
  @@index([deletedById, deletedAt])
}

model AccountingVoucherDeleted {
  id                          String    @id @default(uuid())
  archiveCode                 String    @unique
  originalAccountingVoucherId String
  voucherCode                 String
  voucherType                 String    @db.VarChar(32)
  sourceType                  String    @db.VarChar(64)
  sourceId                    String
  amount                      Decimal   @db.Decimal(18, 2)
  status                      String    @db.VarChar(32)
  createdById                 String
  approvedById                String?
  originalCreatedAt           DateTime
  approvedAt                  DateTime?
  deletedById                 String
  reason                      String
  deletedAt                   DateTime  @default(now())

  @@index([originalAccountingVoucherId])
  @@index([createdById])
  @@index([approvedById])
  @@index([deletedById, deletedAt])
}

model JournalEntryDeleted {
  id                     String   @id @default(uuid())
  archiveCode            String   @unique
  originalJournalEntryId String
  entryCode              String
  sourceType             String   @db.VarChar(64)
  sourceId               String
  status                 String   @db.VarChar(32)
  totalDebit             Decimal  @db.Decimal(18, 2)
  totalCredit            Decimal  @db.Decimal(18, 2)
  createdById            String
  originalCreatedAt      DateTime
  deletedById            String
  reason                 String
  deletedAt              DateTime @default(now())

  @@index([originalJournalEntryId])
  @@index([createdById])
  @@index([deletedById, deletedAt])
}

model JournalLineDeleted {
  id                    String   @id @default(uuid())
  archiveCode           String   @unique
  originalJournalLineId String
  journalEntryId        String
