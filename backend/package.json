{
  "name": "doan-tot-nghiep-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "Dental clinic ERP API using Node.js and SQL Server",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bootstrap-admin": "tsx src/cli/bootstrap-admin.ts",
    "seed-test-users": "tsx src/cli/seed-test-users.ts",
    "test": "vitest run src"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "msnodesqlv8": "^4.2.1",
    "mssql": "^4.2.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "msnodesqlv8@4.5.0": true,
    "esbuild@0.28.2": true
  }
}
